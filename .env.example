# Supabase Configuration for IoT AI Colour Sorting System
# Duplicate this file as .env (or .env.local) and fill in your Supabase project values.

# 1. Project URL (found in Supabase Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Publishable / Anon Public Key (found in Supabase Settings -> API -> Project API keys -> anon public)
# IMPORTANT: DO NOT USE or paste the service_role secret key here!
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here

# 3. Optional: ESP32 Serial USB Bridge Configuration (for esp32/usb_to_supabase.py)
SERIAL_PORT=COM3
BAUD_RATE=115200
